# Скопіюйте у .env і змініть значення за потреби

# PostgreSQL (docker-compose)
POSTGRES_USER=fitclub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fitclub
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgresql+psycopg://fitclub:change-me@localhost:5433/fitclub
# Optional: database for automated tests (default: same server, database fitclub_test)
# TEST_DATABASE_URL=postgresql+psycopg://fitclub:change-me@localhost:5433/fitclub_test
CORS_ORIGINS=["http://localhost:5173"]

# JWT: secret for signing access tokens (at least 32 characters).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Token lifetime in minutes (default 480 = 8 hours)
# JWT_EXPIRE_MINUTES=480
